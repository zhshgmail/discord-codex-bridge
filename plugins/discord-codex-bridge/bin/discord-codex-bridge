#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="${DISCORD_BRIDGE_PLUGIN_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
CODEX_BIN_DEFAULT="${CODEX_BIN:-codex}"
NODE_BIN="${NODE_BIN:-node}"

usage() {
  cat <<'EOF'
Usage:
  discord-codex-bridge install [--instance INSTANCE_VALUE] [--dry-run]
  discord-codex-bridge upgrade [--instance INSTANCE_VALUE] [--dry-run] [--skip-check] [--no-restart]
  discord-codex-bridge connect --instance INSTANCE_VALUE --thread THREAD_ID [--socket SOCKET] [--cwd DIR]
  discord-codex-bridge app-server --instance INSTANCE_VALUE [--socket SOCKET]
  discord-codex-bridge configure-current --instance INSTANCE_VALUE --thread THREAD_ID [--socket SOCKET] [--cwd DIR]
  discord-codex-bridge configure-tty --instance INSTANCE_VALUE [--tty /dev/pts/N | --pid PID] [--cwd DIR]
  discord-codex-bridge doctor [--instance INSTANCE_VALUE] [--channel CHANNEL_ID]
  discord-codex-bridge start|stop|restart|status|logs [--instance INSTANCE_VALUE]
  discord-codex-bridge access [--instance INSTANCE_VALUE] -- <manage-access args>
  discord-codex-bridge send [--instance INSTANCE_VALUE] -- <send-message args>
  discord-codex-bridge list-channels [--instance INSTANCE_VALUE] -- <list-channels args>
  discord-codex-bridge view-channel [--instance INSTANCE_VALUE] -- <view-channel args>
  discord-codex-bridge fetch-messages [--instance INSTANCE_VALUE] -- <fetch-messages args>
  discord-codex-bridge read-message [--instance INSTANCE_VALUE] -- <read-message args>
  discord-codex-bridge path [--instance INSTANCE_VALUE]

Environment-first path overrides:
  DISCORD_BRIDGE_PLUGIN_DIR   Plugin root containing src/, scripts/, bin/
  DISCORD_BRIDGE_INSTANCE     Default instance name
  DISCORD_CONFIG_BASE_DIR     Base directory for per-instance config
  DISCORD_BRIDGE_BIN_DIR      Directory for PATH symlink during install
  DISCORD_BRIDGE_SOCKET_DIR   Base directory for app-server sockets
  CODEX_APP_SERVER_SOCKET     Explicit app-server socket path
  CODEX_CWD                   Codex working directory
  CODEX_TTY                   Explicit target TTY for exact-console injection
  CODEX_TTY_PID               Resolve target TTY from a Codex process PID
  CODEX_BIN                   codex executable
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

quote_env() {
  local value="$1"
  printf "'%s'" "${value//\'/\'\\\'\'}"
}

instance="${DISCORD_BRIDGE_INSTANCE:-${DISCORD_INSTANCE:-}}"
socket="${CODEX_APP_SERVER_SOCKET:-}"
thread_id="${CODEX_TARGET_THREAD_ID:-}"
cwd="${CODEX_CWD:-$PWD}"
tty_path="${CODEX_TTY:-}"
tty_pid="${CODEX_TTY_PID:-}"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --instance)
      instance="${2:-}"
      shift 2
      ;;
    --socket)
      socket="${2:-}"
      shift 2
      ;;
    --thread|--thread-id)
      thread_id="${2:-}"
      shift 2
      ;;
    --cwd)
      cwd="${2:-}"
      shift 2
      ;;
    --tty)
      tty_path="${2:-}"
      shift 2
      ;;
    --pid|--tty-pid)
      tty_pid="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

cmd="${args[0]:-help}"
if [[ ${#args[@]} -gt 0 ]]; then
  args=("${args[@]:1}")
fi

validate_instance() {
  [[ -n "$instance" ]] || die "--instance INSTANCE_VALUE or DISCORD_BRIDGE_INSTANCE is required"
  [[ "$instance" =~ ^[A-Za-z0-9_.@-]+$ ]] || die "invalid instance name: $instance"
}

config_base_dir() {
  printf '%s\n' "${DISCORD_CONFIG_BASE_DIR:-$HOME/.codex/channels/discord}"
}

config_dir() {
  if [[ -n "${DISCORD_CONFIG_DIR:-}" ]]; then
    printf '%s\n' "$DISCORD_CONFIG_DIR"
  elif [[ -n "$instance" ]]; then
    printf '%s/%s\n' "$(config_base_dir)" "$instance"
  else
    printf '%s\n' "$(config_base_dir)"
  fi
}

env_file() {
  printf '%s\n' "${DISCORD_ENV_FILE:-$(config_dir)/.env}"
}

state_dir() {
  printf '%s\n' "${DISCORD_BRIDGE_STATE_DIR:-${DISCORD_STATE_DIR:-$(config_dir)}}"
}

service_name() {
  if [[ -n "$instance" ]]; then
    printf 'discord-codex-bridge@%s.service\n' "$instance"
  else
    printf 'discord-codex-bridge.service\n'
  fi
}

socket_path() {
  if [[ -n "$socket" ]]; then
    printf '%s\n' "$socket"
    return
  fi
  validate_instance
  local base="${DISCORD_BRIDGE_SOCKET_DIR:-${XDG_RUNTIME_DIR:-$HOME/.codex/run}/discord-codex-bridge}"
  printf '%s/%s/app-server.sock\n' "$base" "$instance"
}

socket_url() {
  printf 'unix://%s\n' "$(socket_path)"
}

ensure_env_file() {
  local file
  file="$(env_file)"
  mkdir -p "$(dirname "$file")"
  chmod 700 "$(dirname "$file")"
  [[ -f "$file" ]] || install -m 600 /dev/null "$file"
}

set_env_key() {
  local key="$1"
  local value="$2"
  local file
  file="$(env_file)"
  ensure_env_file
  local tmp
  tmp="$(mktemp)"
  if [[ -f "$file" ]]; then
    grep -v -E "^${key}=" "$file" > "$tmp" || true
  fi
  printf '%s=%s\n' "$key" "$(quote_env "$value")" >> "$tmp"
  install -m 600 "$tmp" "$file"
  rm -f "$tmp"
}

configure_current() {
  validate_instance
  [[ -n "$thread_id" ]] || die "--thread THREAD_ID or CODEX_TARGET_THREAD_ID is required"
  local sock
  sock="$(socket_path)"
  set_env_key DISCORD_BRIDGE_INSTANCE "$instance"
  set_env_key CODEX_TARGET_MODE turn
  set_env_key CODEX_TARGET_THREAD_ID "$thread_id"
  set_env_key CODEX_TARGET_THREAD_RESUME true
  set_env_key CODEX_APP_SERVER_SOCKET "$sock"
  set_env_key CODEX_DENY_SERVER_REQUESTS false
  set_env_key CODEX_TURN_POLL_MS 1000
  set_env_key CODEX_WAKE_ACK_ON_DELIVERY false
  set_env_key CODEX_CWD "$cwd"
  printf 'configured %s\n' "$(env_file)"
}

configure_tty() {
  validate_instance
  if [[ -n "$tty_path" && -n "$tty_pid" ]]; then
    die "use only one of --tty or --pid"
  fi
  set_env_key DISCORD_BRIDGE_INSTANCE "$instance"
  set_env_key CODEX_TARGET_MODE tty
  set_env_key CODEX_TARGET_THREAD_ID ""
  set_env_key CODEX_TARGET_THREAD_RESUME ""
  set_env_key CODEX_APP_SERVER_SOCKET ""
  set_env_key CODEX_DENY_SERVER_REQUESTS ""
  set_env_key CODEX_TURN_POLL_MS ""
  set_env_key CODEX_WAKE_ACK_ON_DELIVERY ""
  if [[ -n "$tty_path" ]]; then
    set_env_key CODEX_TTY "$tty_path"
    set_env_key CODEX_TTY_PID ""
  elif [[ -n "$tty_pid" ]]; then
    [[ "$tty_pid" =~ ^[0-9]+$ ]] || die "invalid --pid value: $tty_pid"
    set_env_key CODEX_TTY_PID "$tty_pid"
    set_env_key CODEX_TTY ""
  else
    set_env_key CODEX_TTY ""
    set_env_key CODEX_TTY_PID ""
  fi
  set_env_key CODEX_TTY_PROMPT_FORMAT "${CODEX_TTY_PROMPT_FORMAT:-minimal}"
  set_env_key CODEX_TTY_BRACKETED_PASTE "${CODEX_TTY_BRACKETED_PASTE:-false}"
  set_env_key CODEX_TTY_SUBMIT_SEQUENCE "${CODEX_TTY_SUBMIT_SEQUENCE:-cr}"
  set_env_key CODEX_TTY_SPLIT_SUBMIT "${CODEX_TTY_SPLIT_SUBMIT:-true}"
  set_env_key CODEX_TTY_SUBMIT_DELAY_MS "${CODEX_TTY_SUBMIT_DELAY_MS:-500}"
  set_env_key CODEX_TTY_ACK_ON_DELIVERY "${CODEX_TTY_ACK_ON_DELIVERY:-false}"
  set_env_key CODEX_CWD "$cwd"
  printf 'configured exact-console TTY mode in %s\n' "$(env_file)"
}

start_app_server() {
  validate_instance
  local sock
  sock="$(socket_path)"
  local dir
  dir="$(dirname "$sock")"
  mkdir -p "$dir"
  if [[ -S "$sock" ]]; then
    printf 'app-server socket already exists: %s\n' "$sock"
    return
  fi
  rm -f "$sock"
  local log="${DISCORD_BRIDGE_APP_SERVER_LOG:-$dir/app-server.log}"
  local pid_file="${DISCORD_BRIDGE_APP_SERVER_PID_FILE:-$dir/app-server.pid}"
  nohup "$CODEX_BIN_DEFAULT" app-server --listen "$(socket_url)" > "$log" 2>&1 &
  printf '%s\n' "$!" > "$pid_file"
  for _ in $(seq 1 50); do
    [[ -S "$sock" ]] && {
      printf 'app-server socket ready: %s\n' "$sock"
      return
    }
    sleep 0.1
  done
  die "app-server socket did not appear: $sock (log: $log)"
}

install_bridge() {
  local install_args=("$@")
  if [[ -n "$instance" ]]; then
    DISCORD_BRIDGE_INSTANCE="$instance" bash "$ROOT_DIR/scripts/install-systemd-user.sh" --instance "$instance" "${install_args[@]}"
  else
    bash "$ROOT_DIR/scripts/install-systemd-user.sh" "${install_args[@]}"
  fi
}

service_unit_exists() {
  systemctl --user cat "$(service_name)" >/dev/null 2>&1
}

ensure_service_installed() {
  service_unit_exists && return 0
  printf 'service %s is not installed; installing it now\n' "$(service_name)"
  install_bridge
}

upgrade_bridge() {
  local dry_run=false
  local skip_check=false
  local no_restart=false
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --dry-run)
        dry_run=true
        shift
        ;;
      --skip-check)
        skip_check=true
        shift
        ;;
      --no-restart)
        no_restart=true
        shift
        ;;
      --help|-h)
        cat <<'EOF'
Usage: discord-codex-bridge upgrade [--instance INSTANCE_VALUE] [--dry-run] [--skip-check] [--no-restart]

Runs local checks, reinstalls the PATH CLI symlink and user systemd service,
then restarts the selected bridge instance unless --no-restart is passed.
EOF
        return 0
        ;;
      *)
        die "unknown upgrade argument: $arg"
        ;;
    esac
  done

  local instance_args=()
  if [[ -n "$instance" ]]; then
    instance_args=(--instance "$instance")
  fi

  if [[ "$dry_run" == "true" ]]; then
    printf '[dry-run] cd %s\n' "$ROOT_DIR"
    if [[ "$skip_check" != "true" ]]; then
      printf '[dry-run] npm run check\n'
    fi
    printf '[dry-run] %s/scripts/install-systemd-user.sh' "$ROOT_DIR"
    if [[ ${#instance_args[@]} -gt 0 ]]; then
      printf ' %s %s' "${instance_args[0]}" "${instance_args[1]}"
    fi
    printf '\n'
    if [[ "$no_restart" == "true" ]]; then
      printf '[dry-run] restart skipped by --no-restart\n'
    else
      printf '[dry-run] systemctl --user restart %s\n' "$(service_name)"
    fi
    return 0
  fi

  if [[ "$skip_check" != "true" ]]; then
    (cd "$ROOT_DIR" && npm run check)
  fi
  install_bridge
  if [[ "$no_restart" != "true" ]]; then
    systemctl --user restart "$(service_name)"
  fi
}

service_action() {
  local action="$1"
  local service
  service="$(service_name)"
  case "$action" in
    logs)
      exec journalctl --user -u "$service" -n "${DISCORD_BRIDGE_LOG_LINES:-100}" --no-pager
      ;;
    status)
      exec systemctl --user status "$service" --no-pager
      ;;
    *)
      systemctl --user "$action" "$service"
      ;;
  esac
}

doctor() {
  local channel=""
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --channel)
        channel="${2:-}"
        shift 2
        ;;
      --help|-h)
        cat <<'EOF'
Usage: discord-codex-bridge doctor [--instance INSTANCE_VALUE] [--channel CHANNEL_ID]

Checks local CLI paths, instance config, systemd service status, access state,
and optionally Discord REST read access for one channel.
EOF
        return 0
        ;;
      *)
        die "unknown doctor argument: $arg"
        ;;
    esac
  done

  validate_instance

  printf '== paths ==\n'
  printf 'plugin_dir=%s\n' "$ROOT_DIR"
  printf 'node=%s\n' "$(command -v "$NODE_BIN" || true)"
  printf 'codex=%s\n' "$(command -v "$CODEX_BIN_DEFAULT" || true)"
  printf 'config_dir=%s\n' "$(config_dir)"
  printf 'env_file=%s\n' "$(env_file)"
  printf 'state_dir=%s\n' "$(state_dir)"
  printf 'socket=%s\n' "$(socket_path)"
  printf 'service=%s\n' "$(service_name)"

  printf '\n== config ==\n'
  local file
  file="$(env_file)"
  if [[ -f "$file" ]]; then
    printf 'env_file_exists=yes\n'
    if grep -q '^DISCORD_BOT_TOKEN=' "$file"; then
      printf 'discord_token=set\n'
    else
      printf 'discord_token=missing\n'
    fi
    grep -E '^(DISCORD_BRIDGE_INSTANCE|DISCORD_CONFIG_DIR|DISCORD_PROXY_URL|DISCORD_INSECURE_TLS|CODEX_TARGET_MODE|CODEX_TARGET_THREAD_ID|CODEX_TARGET_THREAD_RESUME|CODEX_APP_SERVER_SOCKET|CODEX_DENY_SERVER_REQUESTS|CODEX_TURN_POLL_MS|CODEX_TTY|CODEX_TTY_PID|CODEX_TTY_PROMPT_FORMAT|CODEX_CWD)=' "$file" || true
  else
    printf 'env_file_exists=no\n'
  fi

  printf '\n== service ==\n'
  systemctl --user is-active "$(service_name)" || true

  printf '\n== access ==\n'
  DISCORD_BRIDGE_INSTANCE="$instance" "$NODE_BIN" "$ROOT_DIR/scripts/manage-access.js" status || true

  if [[ -n "$channel" ]]; then
    printf '\n== discord-rest ==\n'
    DISCORD_BRIDGE_INSTANCE="$instance" "$NODE_BIN" "$ROOT_DIR/scripts/fetch-messages.js" --channel "$channel" --limit 1
  fi
}

case "$cmd" in
  help)
    usage
    ;;
  path)
    printf 'instance=%s\n' "${instance:-}"
    printf 'config_dir=%s\n' "$(config_dir)"
    printf 'env_file=%s\n' "$(env_file)"
    printf 'state_dir=%s\n' "$(state_dir)"
    if [[ -n "$instance" || -n "$socket" ]]; then
      printf 'socket=%s\n' "$(socket_path)"
      printf 'socket_url=%s\n' "$(socket_url)"
    fi
    printf 'service=%s\n' "$(service_name)"
    ;;
  install)
    install_bridge "${args[@]}"
    ;;
  upgrade)
    upgrade_bridge "${args[@]}"
    ;;
  app-server)
    start_app_server
    ;;
  configure-current)
    configure_current
    ;;
  configure-tty)
    configure_tty
    ;;
  doctor)
    doctor "${args[@]}"
    ;;
  connect)
    validate_instance
    [[ -n "$thread_id" ]] || die "--thread THREAD_ID or CODEX_TARGET_THREAD_ID is required"
    start_app_server
    configure_current
    ensure_service_installed
    systemctl --user restart "$(service_name)"
    exec "$CODEX_BIN_DEFAULT" --remote "$(socket_url)" resume "$thread_id"
    ;;
  start|stop|restart|status|logs)
    service_action "$cmd"
    ;;
  access)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/manage-access.js" "${args[@]}"
    ;;
  send)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/send-message.js" "${args[@]}"
    ;;
  list-channels)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/list-channels.js" "${args[@]}"
    ;;
  view-channel)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/view-channel.js" "${args[@]}"
    ;;
  fetch-messages)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/fetch-messages.js" "${args[@]}"
    ;;
  read-message)
    DISCORD_BRIDGE_INSTANCE="$instance" exec "$NODE_BIN" "$ROOT_DIR/scripts/read-message.js" "${args[@]}"
    ;;
  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
