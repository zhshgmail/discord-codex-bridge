# Discord bot token from Discord Developer Portal -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Optional instance name. When set, defaults isolate config/state under
# ~/.codex/channels/discord/INSTANCE and service env under
# ~/.config/discord-codex-bridge/INSTANCE.env.
# DISCORD_BRIDGE_INSTANCE=codex01

# Optional config/state directory. Without an instance, defaults to
# ~/.codex/channels/discord. With DISCORD_BRIDGE_INSTANCE, defaults to
# ~/.codex/channels/discord/INSTANCE.
# DISCORD_CONFIG_BASE_DIR=/home/YOU/.codex/channels/discord
# DISCORD_CONFIG_DIR=/home/YOU/.codex/channels/discord
# DISCORD_STATE_DIR=/home/YOU/.codex/channels/discord

# Optional explicit HTTP/HTTPS proxy. If omitted, HTTPS_PROXY/HTTP_PROXY are used.
# DISCORD_PROXY_URL=http://proxy.example.com:8080

# Set true only for trusted corporate TLS interception/DLP environments.
DISCORD_INSECURE_TLS=false

# Access policy. Claude-style default is pairing, not automatic bootstrap.
DISCORD_BOOTSTRAP_FIRST_USER=false
DISCORD_BOOTSTRAP_GUILD_MENTIONS=false
DISCORD_REQUIRE_MENTION_IN_GUILDS=true
DISCORD_REQUIRE_ALLOW_FROM_IN_GUILDS=true
DISCORD_ALLOW_EVERYONE=false

# Codex target behavior:
# - tty: inject into an already-running interactive `codex resume` terminal.
#   This can submit local half-typed TUI input together with Discord text; use
#   app-server socket mode for robust current-session bridging.
# - turn: run Codex app-server turn and post final answer to Discord.
# - wake: start app-server turn in a target thread and return no noisy ack.
# - inject: append a raw user item to the target app-server thread.
CODEX_TARGET_MODE=tty
CODEX_CWD=
CODEX_BIN=codex
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=danger-full-access

# Shared app-server socket mode. Use one socket and one target thread per
# Discord bridge instance. Start Codex TUI with:
#   codex app-server --listen unix:///abs/path/app-server.sock
#   codex --remote unix:///abs/path/app-server.sock resume THREAD_ID
# Then set the same socket/thread here.
# CODEX_APP_SERVER_SOCKET=/home/YOU/.codex/app-server-discord/codex01/app-server.sock
# CODEX_TARGET_THREAD_ID=
# CODEX_TARGET_THREAD_RESUME=false
# CODEX_DENY_SERVER_REQUESTS=false
# CODEX_WAKE_ACK_ON_DELIVERY=false

CODEX_TTY_USE_SUDO=true
CODEX_TTY_BRACKETED_PASTE=false
CODEX_TTY_SUBMIT=true
CODEX_TTY_SUBMIT_SEQUENCE=cr
CODEX_TTY_SPLIT_SUBMIT=true
CODEX_TTY_SUBMIT_DELAY_MS=500
CODEX_TTY_ACK_ON_DELIVERY=false
CODEX_TTY_PROMPT_FORMAT=minimal
