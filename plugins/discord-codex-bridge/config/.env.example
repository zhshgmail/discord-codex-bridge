# Discord bot token from Discord Developer Portal -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Optional instance name. When set, defaults isolate config/state under
# $DISCORD_CONFIG_BASE_DIR/$DISCORD_BRIDGE_INSTANCE and service env under
# $XDG_CONFIG_HOME/discord-codex-bridge/$DISCORD_BRIDGE_INSTANCE.env.
# DISCORD_BRIDGE_INSTANCE=codex01

# Optional config/state directory. Without an instance, defaults to
# $HOME/.codex/channels/discord. With DISCORD_BRIDGE_INSTANCE, defaults to
# $DISCORD_CONFIG_BASE_DIR/$DISCORD_BRIDGE_INSTANCE.
# DISCORD_CONFIG_BASE_DIR=$HOME/.codex/channels/discord
# DISCORD_CONFIG_DIR=$DISCORD_CONFIG_BASE_DIR/$DISCORD_BRIDGE_INSTANCE
# DISCORD_STATE_DIR=$DISCORD_CONFIG_DIR
# DISCORD_BRIDGE_BIN_DIR=$HOME/.local/bin

# Optional explicit HTTP/HTTPS proxy. If omitted, HTTPS_PROXY/HTTP_PROXY are used.
# DISCORD_PROXY_URL=http://proxy.example.com:8080

# Set true only for trusted corporate TLS interception/DLP environments.
DISCORD_INSECURE_TLS=false

# Access policy. Claude-style default is pairing, not automatic bootstrap.
DISCORD_BOOTSTRAP_FIRST_USER=false
DISCORD_BOOTSTRAP_GUILD_MENTIONS=false
DISCORD_REQUIRE_MENTION_IN_GUILDS=true
DISCORD_REQUIRE_ALLOW_FROM_IN_GUILDS=true
DISCORD_ALLOW_EVERYONE=false

# Codex target behavior:
# - tty: inject into an already-running interactive Codex terminal. This is the
#   exact-console path. It can submit local half-typed TUI input together with
#   Discord text, so bind it only to the terminal you intentionally want.
# - turn: run a Codex app-server sidecar turn and post final answer to Discord.
#   With CODEX_APP_SERVER_SOCKET set, the bridge connects to the same Unix
#   WebSocket /rpc app-server used by `codex --remote`, but it does not inject
#   text into the active terminal input.
# - wake: start app-server turn in a target thread and return no noisy ack.
# - inject: append a raw user item to the target app-server thread.
CODEX_TARGET_MODE=tty
CODEX_CWD=
CODEX_BIN=codex
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=danger-full-access

# Shared app-server sidecar mode. Use one socket and one target thread per
# Discord bridge instance. Start Codex TUI with:
#   DISCORD_BRIDGE_SOCKET_DIR=$HOME/.codex/run/discord-codex-bridge
#   CODEX_APP_SERVER_SOCKET=$DISCORD_BRIDGE_SOCKET_DIR/$DISCORD_BRIDGE_INSTANCE/app-server.sock
#   discord-codex-bridge app-server --instance "$DISCORD_BRIDGE_INSTANCE" --socket "$CODEX_APP_SERVER_SOCKET"
#   codex --remote "unix://$CODEX_APP_SERVER_SOCKET" resume THREAD_ID
# Then set the same socket/thread here.
# DISCORD_BRIDGE_SOCKET_DIR=$HOME/.codex/run/discord-codex-bridge
# CODEX_APP_SERVER_SOCKET=$DISCORD_BRIDGE_SOCKET_DIR/$DISCORD_BRIDGE_INSTANCE/app-server.sock
# CODEX_TARGET_THREAD_ID=
# CODEX_TARGET_THREAD_RESUME=true
# CODEX_DENY_SERVER_REQUESTS=false
# CODEX_TARGET_MODE=turn
# CODEX_TURN_TIMEOUT_MS=1800000
# CODEX_TURN_POLL_MS=1000
# CODEX_THREAD_IDLE_POLL_MS=500
# CODEX_THREAD_IDLE_TIMEOUT_MS=60000
# CODEX_THREAD_FINAL_ANSWER_IDLE_GRACE_MS=2000
# CODEX_WAKE_ACK_ON_DELIVERY=false

CODEX_TTY_USE_SUDO=true
CODEX_TTY_BRACKETED_PASTE=false
CODEX_TTY_SUBMIT=true
CODEX_TTY_SUBMIT_SEQUENCE=cr
CODEX_TTY_SPLIT_SUBMIT=true
CODEX_TTY_SUBMIT_DELAY_MS=500
CODEX_TTY_ACK_ON_DELIVERY=false
CODEX_TTY_PROMPT_FORMAT=minimal
